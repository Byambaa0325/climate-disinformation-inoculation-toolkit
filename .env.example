# ================================================
# Climate Disinformation Lab - Environment Config
# ================================================

# ----------------
# AWS Bedrock (REQUIRED for LLM features)
# ----------------
# Team ID from the UCL Bedrock Proxy API
BEDROCK_TEAM_ID=your-team-id-here

# API token for Bedrock Proxy
BEDROCK_API_TOKEN=your-api-token-here

# Bedrock Proxy base URL
BEDROCK_API_BASE_URL=https://api.anthropic.com  # replace with proxy URL

# Default model for disinformation injection generation
BEDROCK_DEFAULT_MODEL=us.amazon.nova-pro-v1:0

# Model for evaluation
BEDROCK_EVALUATION_MODEL=us.anthropic.claude-3-5-sonnet-20241022-v2:0

# ----------------
# Security
# ----------------
ENABLE_RATE_LIMITING=true
ENABLE_QUOTAS=true
IP_RATE_LIMIT_PER_MINUTE=10
IP_RATE_LIMIT_PER_HOUR=100
IP_DAILY_REQUEST_QUOTA=200
IP_DAILY_COST_QUOTA=5.0
REQUIRE_API_KEY=false
API_KEYS=
ADMIN_API_KEY=

# ----------------
# Frontend
# ----------------
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_API_KEY=

# ----------------
# Development
# ----------------
FLASK_ENV=development
FLASK_DEBUG=true
PORT=5000
